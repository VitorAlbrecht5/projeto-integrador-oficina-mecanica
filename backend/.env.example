# Copie para backend/.env (não versione o .env real)
MONGODB_URI=mongodb://127.0.0.1:27017/oficina
PORT=3000

# Administrador inicial: defina valores próprios no arquivo .env
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=substitua-por-uma-senha-forte

# Gere uma chave aleatória (exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=substitua-por-uma-chave-forte-e-aleatoria
